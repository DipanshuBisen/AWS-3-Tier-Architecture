pipeline {
    agent any

    environment {
        AWS_REGION = 'ap-south-1'

        TF_DIR = 'infra/environments/dev'

        SSM_AMI_PARAMETER = '/dev/application/ami-id'

        TF_IN_AUTOMATION = 'true'
    }

    triggers {
        // GitHub webhook triggers this pipeline
        githubPush()
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Detect Changes') {
            steps {
                script {

                    def changes = sh(
                        script: "git diff --name-only HEAD~1 HEAD || true",
                        returnStdout: true
                    ).trim()

                    echo "Changed files:"
                    echo changes

                    if (changes) {
                        def infraChanged = changes.split('\n').any {
                            it.startsWith('infra/')
                        }

                        if (infraChanged) {
                            echo "Infrastructure changes detected."
                        } else {
                            echo "No Terraform changes detected."
                        }
                    }
                }
            }
        }

        stage('Terraform Init') {
            steps {
                dir("${TF_DIR}") {
                    sh '''
                        terraform init
                    '''
                }
            }
        }

        stage('Get Latest AMI from SSM') {
            steps {
                script {

                    env.LATEST_AMI_ID = sh(
                        script: """
                            aws ssm get-parameter \
                            --name '${SSM_AMI_PARAMETER}' \
                            --query 'Parameter.Value' \
                            --output text \
                            --region '${AWS_REGION}'
                        """,
                        returnStdout: true
                    ).trim()

                    echo "Latest AMI from SSM: ${env.LATEST_AMI_ID}"
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                dir("${TF_DIR}") {
                    sh '''
                        terraform validate
                    '''
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                dir("${TF_DIR}") {
                    sh '''
                        terraform plan \
                        -out=tfplan
                    '''
                }
            }
        }

        stage('Approval') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    input message: 'Do you want to apply Terraform changes?',
                          ok: 'Apply'
                }
            }
        }

        stage('Terraform Apply') {
            steps {
                dir("${TF_DIR}") {
                    sh '''
                        terraform apply -auto-approve tfplan
                    '''
                }
            }
        }

        stage('Verify Infrastructure') {
            steps {
                dir("${TF_DIR}") {
                    sh '''
                        terraform output
                    '''
                }

                echo "Infrastructure deployment completed successfully."
                echo "AMI used from SSM: ${env.LATEST_AMI_ID}"
            }
        }
    }

    post {

        success {
            echo 'Terraform pipeline completed successfully.'
        }

        failure {
            echo 'Terraform pipeline failed.'
        }

        always {
            cleanWs()
        }
    }
}