pipeline {
    agent any

     environment {
        APP_DIR = "Java-Login-App"
        BRANCH  = "main"
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                credentialsId: 'github-credentials',
                url: 'https://github.com/DipanshuBisen/AWS-3-Tier-Architecture.git'
            }
        }

        stage('Check Application Changes') {
            steps {
                script {

                    def changedFiles = sh(
                        script: "git diff --name-only HEAD~1 HEAD",
                        returnStdout: true
                    ).trim()

                    echo "Changed Files:"
                    echo changedFiles

                    if (!changedFiles.contains("${APP_DIR}/")) {

                        currentBuild.result = "NOT_BUILT"

                        error("No changes detected in ${APP_DIR}. Exiting pipeline.")

                    }

                    echo "Application changes detected. Continuing..."
                }
            }
        }
        
        stage('Build') {
            steps {
                echo 'Building...'
                dir('Java-Login-App') {
                    sh '''
                        echo "Building Java Application..."
                        mvn clean package -DskipTests
                    '''
                }
            }
        }

        stage('Unit Test') {
            steps {
                dir('Java-Login-App') {
                sh '''
                    echo "Running unit tests..."
                    mvn test
                '''
                }
            }
            
            post {
                always {
                    junit 'Java-Login-App/target/surefire-reports/*.xml'
                }
             }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('Java-Login-App') {
                    withSonarQubeEnv('SonarQube') {
                        sh '''
                            mvn sonar:sonar \
                            -Dsonar.projectKey=Java-Login-App \
                            -Dsonar.projectName=Java-Login-App
                        '''
                    }
                }
            }
        }

        stage('Upload Artifact to JFrog') {
            steps {
                dir('Java-Login-App') {
                    script {
                        env.APP_VERSION = "1.0.${BUILD_NUMBER}"

                        sh '''
                            echo "Uploading application artifact..."

                            JAR_FILE=$(find target -maxdepth 1 \
                            -name "*.jar" \
                            ! -name "*-plain.jar" \
                            | head -1)

                            if [ -z "$JAR_FILE" ]; then
                            echo "ERROR: JAR file not found"
                            exit 1
                            fi

                            echo "JAR: $JAR_FILE"
                            echo "Version: $APP_VERSION"

                            jfrog rt upload \
                            "$JAR_FILE" \
                            "java-login/$APP_VERSION/java-login-$APP_VERSION.jar"
                        '''
                    }
                }
            }
        }

        stage('Build AMI with Packer') {
            steps {
                dir('packer/java-login-app') {
                    sh '''
                        echo "===================================="
                        echo "Initializing Packer"
                        echo "===================================="

                        packer init .

                        echo "===================================="
                        echo "Validating Packer configuration"
                        echo "===================================="

                        packer validate .

                        echo "===================================="
                        echo "Building AMI"
                        echo "===================================="

                        packer build \
                        -var "ami_name=java-login-app-${APP_VERSION}" \
                        -var "jar_url=${JFROG_URL}/java-login/${APP_VERSION}/java-login-${APP_VERSION}.jar" \
                        .
                    '''
                }
            }
        }
        
        
    }

    post {
        always {
            echo 'Pipe line Finished'
        }
    }
}